# CSA Hub - Environment Variables Template
# Copy this file to .env and fill in the values

# Next Auth Configuration
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# AI Model API Keys (Mocked in prototype)
AI_MODEL_API_KEY=your_api_key_here
AI_MODEL_ENDPOINT=https://api.example.com/v1

# Weather API Configuration (Mocked in prototype)
WEATHER_API_KEY=your_weather_api_key_here

# Database Configuration (Future Implementation)
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/csahub?schema=public"
