{
    "name": "csa-project-nexus",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo check-types",
        "deploy:web": "firebase deploy --only hosting",
        "deploy:web:preview": "firebase hosting:channel:deploy preview --only hosting"
    },
    "devDependencies": {
        "prettier": "^3.1.0",
        "turbo": "^2.8.1",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "npm@10.2.4",
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
